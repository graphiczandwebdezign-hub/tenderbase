#!/bin/sh
# Gradle start up script for POSIX generated by Gradle.
#
# NOTE(arena-ci): temporary CI diagnostics hook (1.2 branch only). When run on
# GitHub Actions, the console output is captured and pushed to the throwaway
# `ci-log` branch on failure so it can be read back via the API. Remove this
# wrapper change once the 1.2 build is green.
APP_HOME=$(cd "$(dirname "$0")" >/dev/null && pwd)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

LOGF="$APP_HOME/ci-console.log"
rm -f "$LOGF"

"$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
    "-Dorg.gradle.appname=gradlew" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@" > "$LOGF" 2>&1
RC=$?
cat "$LOGF"

if [ "$GITHUB_ACTIONS" = "true" ]; then
    ROOT=$(cd "$APP_HOME/.." >/dev/null && pwd)
    tail -c 400000 "$LOGF" > "$LOGF.short" 2>/dev/null && mv "$LOGF.short" "$LOGF"
    if git -C "$ROOT" add -f android/ci-console.log >/dev/null 2>&1 && \
       git -C "$ROOT" -c user.name=arena-ci -c user.email=arena-ci@local \
           commit -q -m "ci: gradle console log ($([ $RC -eq 0 ] && echo ok || echo FAILED), sha $(git -C "$ROOT" rev-parse --short HEAD))" >/dev/null 2>&1; then
        git -C "$ROOT" push -f origin "HEAD:refs/heads/ci-log" >/dev/null 2>&1 \
            && echo "arena-ci: console log pushed to branch ci-log"
    fi
fi

exit $RC
