    <color name="cardStroke">#2A3440</color>
    <color name="ripple">#247FB0FF</color>
    <color name="iconBackground">#0E2A47</color>
    <color name="windowBackground">#0D1117</color>

    <color name="badgeOpenBg">#123326</color>
