<?xml version="1.0" encoding="utf-8"?>
<!--
  Night-mode window colors. Dark mode is an intentional deep-navy palette
  (previously the app shipped NO night resources at all, which left light
  tokens floating on dark surfaces). Compose theme values live in
  ui/theme/TbTheme.kt; these match them.
-->
