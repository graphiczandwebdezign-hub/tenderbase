<?xml version="1.0" encoding="utf-8"?>
<!-- One saved search: name, filter summary, alerts toggle, delete -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/cardStroke"
    app:strokeWidth="1dp"
    app:rippleColor="@color/ripple"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/searchName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="KZN construction" />

        <TextView
            android:id="@+id/searchSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/textMuted"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="“construction” · KwaZulu-Natal · Closing &lt; 7d" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/alertsSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/cd_search_alerts"
                android:textColor="@color/textMuted"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_trash"
                app:tint="@color/textMuted"
                android:contentDescription="@string/cd_delete_search" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
