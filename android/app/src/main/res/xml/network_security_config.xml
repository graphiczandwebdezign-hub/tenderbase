<?xml version="1.0" encoding="utf-8"?>
<!--
  eTenders publishes some tender document URLs over plain HTTP. Android 9+
  blocks cleartext traffic by default, which can silently fail downloads, so we
  explicitly permit cleartext for the eTenders domains only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">etenders.gov.za</domain>
    </domain-config>
</network-security-config>
