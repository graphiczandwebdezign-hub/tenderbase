# ============================================================================
# SA Tender API — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# ---- Application ----
APP_ENV=development            # development | production
APP_NAME=SA Tender API
APP_VERSION=1.0.0
DEBUG=false
TIMEZONE=Africa/Johannesburg

# ---- Database ----
# Production/Docker: use PostgreSQL.
DATABASE_URL=postgresql+psycopg2://tender:tender@db:5432/tenderbase
# Local without Postgres (dev only): sqlite:///./tenderbase.db

# ---- Authentication ----
# Bootstrap application API key. Sent by clients as: X-API-Key: <value>
# On startup this key is hashed and ensured to exist in the api_keys table.
API_KEY=change-me-to-a-long-random-string
# Admin API + dashboard secret. Sent as: X-Admin-Secret: <value>
ADMIN_SECRET=change-me-admin-secret

# ---- Sync / ingestion ----
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15
SYNC_LOOKBACK_DAYS=3
SYNC_BACKFILL_DAYS=30
ETENDERS_BASE_URL=https://ocds-api.etenders.gov.za/api/OCDSReleases
ETENDERS_PAGE_SIZE=50
ETENDERS_MAX_PAGES=40
ETENDERS_TIMEOUT_SECONDS=45
# Load bundled dev sample when the live source is unreachable AND the DB is
# empty. Ignored in production (APP_ENV=production).
INGESTION_ALLOW_SAMPLE_FALLBACK=true

# ---- Expiry / retention ----
TENDER_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=24
CLOSING_SOON_HOURS=48

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# ---- CORS (comma-separated; * = all) ----
CORS_ORIGINS=*

# ---- FCM / push notifications (optional; foundation) ----
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ---- Deadline reminders (hours before closing, comma-separated) ----
REMINDER_OFFSETS_HOURS=168,72,24,3
